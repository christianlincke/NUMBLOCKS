{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "emulicious-debugger",
            "request": "launch",
            "name": "Launch in Emulicious",
            "program": "${workspaceFolder}/build/gb/NUMBLOCKS.gb",
            "port": 58870,
            "stopOnEntry": true,
            "preLaunchTask": "Build ROM debug",
            "additionalSrcFolders": "${workspaceFolder}/src/gb;${workspaceFolder}/src/core"
        },
        {
            "name": "Debug Tests",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/test/test",
            "args": [],
            "cwd": "${workspaceFolder}/test",
            "preLaunchTask": "Build Tests"
        },
        {
            "name": "Debug CLI",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/cli/NUMBLOCKS",
            "args": [],
            "cwd": "${workspaceFolder}/src/cli",
            "preLaunchTask": "Build CLI"
        }
    ]
}